# =====================================================================
# TechPath Learning Intelligence Environment Variables (Production & Local)
# NOTE: Never commit real API keys to version control.
# =====================================================================

# Server Port (Default: 8000)
PORT=8000

# 1. Apify API Token (Used for Apify Store Scrapers & Cloud Actor execution)
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# 2. Primary LLM Provider API Keys (Server-side execution)
# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Get at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT API Key (Get at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Generic fallback key (used if provider-specific key is omitted)
LLM_API_KEY=your_llm_api_key_here

# 3. Optional Direct Search Provider API Keys (Used if Apify tokens are omitted)
# YouTube Data API v3 Key (Optional direct search provider)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Custom Search API Key & Search Engine ID (Optional direct web search provider)
GOOGLE_SEARCH_API_KEY=your_google_custom_search_key_here
SEARCH_ENGINE_ID=your_custom_search_engine_id_here
