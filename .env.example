# Apify API Token (Optional if running locally without Apify Cloud API calls)
APIFY_TOKEN=your_apify_token_here

# Google Gemini API Key (Free Tier available at https://aistudio.google.com/)
# Uses the gemini-flash-latest alias (no pinned version number).
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API key (optional; used when llmProvider is claude or auto-fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
